<?xml version="1.0" encoding="utf-8"?>
<!--
  代码覆盖率采集设置，由 ci.yml 的测试步骤以绝对路径传入。
  从覆盖率插桩中排除 XiHan.Framework.Docs.Mcp 程序集，该程序集的测试照常执行。
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*XiHan\.Framework\.Docs\.Mcp\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
