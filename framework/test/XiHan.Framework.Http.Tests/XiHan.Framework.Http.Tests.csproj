<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\props\netcore.props" />
	<Import Project="..\..\props\common.props" />

	<PropertyGroup>
		<!-- 本项目目前只有 ProxyUsageExamples.cs / SocksProxyExample.cs 两份用法示例，
		     一个 [Fact] 都没有，两份示例也未引用 xunit。因此不 Import test.props：
		     引了它才会带进 xunit 与测试宿主，把一个没有测试的工程变成可执行的测试目标。
		     Microsoft.Testing.Platform 会把「零项测试」判为错误（退出码 5，VSTest 则容忍），
		     整条 CI 会被它卡住。
		     ⚠ 写第一个 [Fact] 时，把 test.props 的 Import 与版本覆写加回来，并删掉这段。 -->
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\XiHan.Framework.Http\XiHan.Framework.Http.csproj" />
	</ItemGroup>

</Project>
