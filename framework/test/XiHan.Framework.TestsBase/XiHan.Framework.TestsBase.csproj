<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\props\netcore.props" />
	<Import Project="..\..\props\common.props" />

	<PropertyGroup>
		<Title>XiHan.Framework.TestsBase</Title>
		<AssemblyName>XiHan.Framework.TestsBase</AssemblyName>
		<PackageId>XiHan.Framework.TestsBase</PackageId>
		<Description>曦寒框架测试基础库</Description>
		<OutputType>Library</OutputType>
		<!-- 这是供其它测试工程继承的共享基础库，本身不含任何测试，故不 Import test.props：
		     引了它会带进测试宿主，把这个库变成可执行的测试目标，而
		     Microsoft.Testing.Platform 把「零项测试」判为错误（退出码 5），会卡住整条 CI。 -->
		<IsPackable>false</IsPackable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

</Project>
